<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <PackageId>mcpserver.thinqconnect</PackageId>
    <ToolCommandName>mcpserver.thinqconnect</ToolCommandName>
    <RootNamespace>ModelContextProtocolServer.ThinQConnect</RootNamespace>
    <AssemblyName>mcpserver.thinqconnect</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageProjectUrl>https://github.com/StefH/mcpserver.ThinQConnect</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/StefH/mcpserver.ThinQConnect</RepositoryUrl>
    <ApplicationIcon>../../resources/icon.ico</ApplicationIcon>
    <Copyright>Copyright © Stef Heyenrath</Copyright>
    <Authors>Stef Heyenrath</Authors>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <PackageTags>MCP;ModelContextProtocol;AI;Server;Stdio;Sse;ThinQ;LG</PackageTags>
    <Description>A hybrid (SSE or stdio) MCP server for the LG ThinQ Smart Solutions API.</Description>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="../../resources/icon.png" Pack="true" PackagePath="" />
    <None Include="../../PackageReadme.md" Pack="true" PackagePath="" Link="PackageReadme.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocolServer.Hybrid" Version="0.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="mcpserver.ThinQConnect.ConsoleApp" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <Target Name="UpdateServerJsonVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <ServerJsonPath>$(MSBuildProjectDirectory)\.mcp\server.json</ServerJsonPath>
      <CSProjPath>$(MSBuildProjectDirectory)\mcpserver.ThinQConnect.csproj</CSProjPath>
      <UpdateScriptPath>$(MSBuildProjectDirectory)\..\Update-ServerJsonVersion.ps1</UpdateScriptPath>
    </PropertyGroup>

    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(UpdateScriptPath)&quot; -ServerJsonPath &quot;$(ServerJsonPath)&quot; -CSProjPath &quot;$(CSProjPath)&quot;" />
  </Target>

</Project>
